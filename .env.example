# ============================================================
# Elleva Tickets — variáveis de ambiente
# Copie para .env.local (dev) e configure na Vercel (produção).
# ============================================================

# --- App ---
# URL pública do site (SEM barra no final). Em produção é obrigatória:
# alimenta o notification_url do Mercado Pago e os links dos e-mails.
NEXT_PUBLIC_APP_URL=https://www.ellevaeventos.com.br

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # secreta — só no servidor

# --- Cifra dos segredos guardados no banco ---
# OBRIGATÓRIA pra cadastrar conta de pagamento em /admin/pagamentos: é a chave
# que cifra o access token dentro do Postgres (AES-256-GCM). 32 bytes em base64.
# Gerar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: se esta chave mudar, os tokens já salvos param de abrir e as
# credenciais precisam ser coladas de novo na tela. Guarde junto das outras.
SETTINGS_ENC_KEY=

# --- Pagamento ---
# A partir da migration 0062, a conta ativa é cadastrada em /admin/pagamentos e
# manda em TUDO abaixo. As variáveis desta seção continuam valendo como
# FALLBACK: só entram em cena quando não há nenhuma conta ativa no banco
# (primeiro deploy, ou se alguém desativar o cadastro pra rollback).
PAYMENT_PROVIDER=mercadopago

# --- Mercado Pago (fallback — o normal é cadastrar em /admin/pagamentos) ---
# Access Token de PRODUÇÃO (começa com APP_USR-...). Server-side, secreto.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Public Key de produção (client-side, tokeniza o cartão no navegador).
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-xxxxxxxx
# "Assinatura secreta" do webhook (painel MP > Webhooks). Valida o x-signature.
MP_WEBHOOK_SECRET=xxxxxxxx

# --- E-mail: SMTP (Zoho ou qualquer provedor) ---
# Envia o ingresso/certificado. Sem isso o fluxo funciona, só não manda e-mail.
# Zoho: host smtp.zoho.com, porta 465, user = e-mail, pass = senha de app.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=contato@ellevaeventos.com.br
SMTP_PASS=senha-de-app-do-zoho          # secreta
MAIL_FROM=Elleva Tickets <contato@ellevaeventos.com.br>

# --- Cron (Vercel Scheduled) ---
# Protege as rotas de cron (expira Pix não pago, lembretes de evento).
CRON_SECRET=uma-string-aleatoria-longa

# ── Sentry (rastreio de erros) ───────────────────────────────────────────────
# DSN do projeto (org ramponi19 / elleva-tickets). NÃO é segredo: vai pro
# navegador de qualquer forma. Vazio = SDK inerte, nada é enviado.
NEXT_PUBLIC_SENTRY_DSN=
# Liga o Sentry em desenvolvimento (por padrão só reporta em produção).
NEXT_PUBLIC_SENTRY_DEV=
# Token de upload dos source maps no build (só no CI/Vercel; sem ele o build
# funciona, mas o erro chega minificado).
SENTRY_AUTH_TOKEN=
